<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Deterministic>false</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="resources\AWS_SQS_ExtIcon.png">
      <LogicalName>psn.PH.AWS_SQS_ExtIcon.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="resources\buildinfo.txt">
      <LogicalName>psn.PH.buildinfo.txt</LogicalName>
    </EmbeddedResource>    
    <Content Include="resources\*.*">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="OutSystems.ExternalLibraries.SDK" Version="1.7.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="AWSSDK.SQS" Version="4.0.100.21" />
  </ItemGroup>
</Project>